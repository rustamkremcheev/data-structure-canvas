{
  "name": "datacanvas",
  "private": true,
  "version": "0.1.0",
  "description": "DataCanvas — a visual environment for manual algorithmic thinking. Don't watch algorithms. Think through them.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@xyflow/react": "^12.8.0",
    "dexie": "^4.0.11",
    "immer": "^10.1.1",
    "lucide-react": "^0.540.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.0.1",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^4.1.12"
  }
}
